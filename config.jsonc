[{
    "name": "top",
    "layer": "top",
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "modules-left": ["group/left"],
    "modules-center": ["group/center"],
    "modules-right": ["group/right"],
    "group/center": {
      "orientation": "inherit",
      "modules": ["custom/suspend","clock", "custom/poweroff"]
    },
    "group/right": {
      "orientation": "inherit",
      "modules": ["hyprland/language", "group/subright", "pulseaudio", "battery"]
    },
    "group/left": {
      "orientation": "inherit",
      "modules": ["hyprland/workspaces"]
    },
    "group/subright": {
      "orientation": "inherit",
      "modules": ["power-profiles-daemon","custom/notifications"]
    },
    "hyprland/window": {
        "max-length": 50
    },
    "battery": {
        "states": {
          "high": 100,
          "half": 50,
          "low": 25,
          },
        "format": "{capacity}% {icon}",
        "format-icons": {
          "default": ["󱊡", "󱊢", "󱊣"],
          "charging": ["󱊤", "󱊥", "󱊦"]
        }
    },
    "clock": {
        "format-alt": "{:%a, %d. %b  %H:%M}",
        "tooltip": false
    },
    "pulseaudio": {
	"format": "{volume}% {icon}",
	"format-bluetooth": "{volume}% {icon}",
	"format-muted": "󰝟",
	"format-icons": {
		"alsa_output.pci-0000_00_1f.3.analog-stereo": "",
		"alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
		"headphone": "󰋋",
		//"hands-free": "󰂑",
		//"headset": "󰂑",
		//"phone": "",
		//"phone-muted": "",
		//"portable": "",
		//3"car": "",
		"default": ["", ""]
	},
	"scroll-step": 1,
	"on-click": "pavucontrol"
},
"hyprland/workspaces": {
	"format": "{name}",
	"format-icons": {},
	"persistent-workspaces": {
		"*": 5, // 2-5 on every monitor
		"HDMI-A-1": [ 1 ] // but only workspace 1 on HDMI-A-1
	}
},
"power-profiles-daemon": {
  "format": "{icon}",
  /*"tooltip-format": "Power profile: {profile}nCPU driver: {cpu_driver}nPlatform driver: {platform_driver}", */
  "tooltip": true,
  "format-icons": {
    "default": "⚡",
    "performance": "󰠠",
    "balanced": "󰗑",
    "power-saver": "󰌪"
  }
},
"custom/notifications": {
  "format": "{}",
	// "exec": "dunstctl is-paused | grep -q 'true' && echo '{\"text\": \"\", \"class\": \"paused\"}' || echo ''",
	"exec": "if dunstctl is-paused | grep -q true; then echo '{\"text\":\"󰂛\",\"class\":\"paused\"}'; else echo '{\"text\":\"󰂞\",\"class\":\"active\"}'; fi",
  "on-click": "dunstctl set-paused toggle && pkill -RTMIN+8 waybar",
	"signal": 8,
  "tooltip": false,
  "return-type": "json",
},
"hyprland/language": {
	"format-en": "🏴󠁧󠁢󠁥󠁮󠁧󠁿",
	"format-uk": "🇺🇦",
	"format-fr": "🇨🇵"
},
"custom/poweroff": {
  "format": "󰐥",
  "tooltip": false,
  "on-click": "shutdown now"
}, // shutdown now shortcut
"custom/suspend": {
  "format": "󰤄",
  "tooltip": false,
  "on-click": "systemctl suspend"
} // systemctl suspend shortcut
},

// BOTTOM BAR
// BOTTOM BAR
// BOTTOM BAR

{
  "name": "bottom",
  "layer": "top",
  "position": "bottom",
	"margin-top": 0,
	"margin-left": 0,
	"margin-right": 0,
  "modules-left": [],
  "modules-center": [],
  "modules-right": ["group/hardware"],
  "group/hardware": {
    "orientation": "inherit",
    "modules": ["disk", "network", "temperature", "cpu", "memory"]
  },
  "cpu": {
    "interval": 1,
    "format": "CPU: {usage}% LOAD: {load} |",
    "tooltip": false
  },
  "memory": {
  "format": "MEM: {used:0.1f}G |",
	"interval": 2,
	"tooltip": false
  },
  "temperature": {
	"format-critical": "{temperatureC}°C ",
	"format": "TEMP: {temperatureC}°C |",
	"tooltip": false
  },
  "disk": {
    "interval": 30,
    "path": "/home",
    "format": "DISK: {specific_free:0.2f}G/{specific_total:0.2f}G (/home) | ",
    "unit": "GB",
    "tooltip": false
  },
  "network": {
    "interface": "wlan0",
    "format": " {ifname} |",
    "format-wifi": " {essid} ({signalStrength}%) |",
    "format-ethernet": " {ifname} |",
    "format-disconnected": "disconnected |",
    "tooltip": false
  } // can also implement {ipaddr} (larp)
}]
